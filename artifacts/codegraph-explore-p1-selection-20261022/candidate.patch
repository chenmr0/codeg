+    if (output.length + lead.length <= options.maxOutputChars) output += lead;
+    for (const target of missing.slice(0, 8)) {
+      const line = `- Omitted body: ${target}\n`;
+      if (output.length + line.length > options.maxOutputChars) break;
+      output += line;
+    }
+  }
+  return output;
+}
