{
  "name": "@sdd/codegraph-wx",
  "version": "1.0.7",
  "description": "Supercharge Claude Code with semantic code intelligence. 94% fewer tool calls • 77% faster exploration • 100% local.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "codegraph": "./dist/bin/codegraph.js"
  },
  "files": [
    "dist",
    "scripts",
    "codegraph-scan/Cargo.toml",
    "codegraph-scan/Cargo.lock",
    "codegraph-scan/src",
    "docs/rust-scan-prototype.md",
    "docs/native-scan-release.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && npm run copy-assets && node -e \"require('fs').chmodSync('dist/bin/codegraph.js', 0o755)\"",
    "build:rust-scan": "node scripts/build-rust-scan.mjs",
    "validate:rust-scan": "node scripts/validate-rust-scan.mjs",
    "check:rust-scan": "node scripts/check-rust-scan-artifacts.mjs",
    "test:rust-scan": "node --liftoff-only node_modules/vitest/vitest.mjs run --config vitest.rust-scan.config.mts",
    "smoke:native-package": "node scripts/smoke-native-package.mjs",
    "prepack": "npm run check:rust-scan",
    "postinstall": "node scripts/prepare-native-scan.mjs",
    "preuninstall": "node dist/bin/uninstall.js",
    "copy-assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist/db',{recursive:true});fs.copyFileSync('src/db/schema.sql','dist/db/schema.sql');fs.mkdirSync('dist/extraction/wasm',{recursive:true});fs.readdirSync('src/extraction/wasm').filter(f=>f.endsWith('.wasm')).forEach(f=>fs.copyFileSync('src/extraction/wasm/'+f,'dist/extraction/wasm/'+f));const sqlWasm=require.resolve('sql.js-fts5/dist/sql-wasm.wasm');fs.copyFileSync(sqlWasm,'dist/db/sql-wasm.wasm')\"",
    "dev": "tsc --watch",
    "cli": "npm run build && node dist/bin/codegraph.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:eval": "vitest run __tests__/evaluation/",
    "test:dist-sync-self-heal": "npm run build && node scripts/test-dist-sync-self-heal.mjs",
    "eval": "npm run build && npx tsx __tests__/evaluation/runner.ts",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "code-intelligence",
    "knowledge-graph",
    "static-analysis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@vscode/ripgrep": "^1.18.0",
    "commander": "^14.0.2",
    "fast-string-width": "^3.0.2",
    "fast-wrap-ansi": "^0.2.0",
    "ignore": "^7.0.5",
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.3",
    "sisteransi": "^1.0.5",
    "sql.js-fts5": "^1.4.0",
    "tree-sitter-wasms": "^0.1.11",
    "web-tree-sitter": "^0.25.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.19.30",
    "@types/picomatch": "^4.0.2",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0 <25.0.0"
  }
}
